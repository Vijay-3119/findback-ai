# ==============================================================================
# FindBack AI - Environment Configuration
# ==============================================================================

# Google Gemini API Key (Server-Side Only - NEVER expose to browser/client)
# Get your API key from Google AI Studio: https://aistudio.google.com/
GEMINI_API_KEY=""

# PostgreSQL Connection String (Compatible with Vercel Postgres / Neon / Supabase)
# If left empty, FindBack AI uses a resilient in-memory storage with file cache
DATABASE_URL="postgres://user:password@hostname:5432/findback_ai?sslmode=require"

# Base Application URL (Optional for self-referential links)
NEXT_PUBLIC_APP_URL="https://findback-ai.vercel.app"

# Optional Hosted Object Storage for permanent image uploads (Vercel Blob / S3 / Cloudinary)
# When omitted, data URLs & safe remote URLs are utilized seamlessly
BLOB_READ_WRITE_TOKEN=""
